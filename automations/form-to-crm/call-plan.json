      "show": "Confirm require_secret and upsert_field email. Resolve the worksheet at run time."
    },
    {
      "mode": "live",
      "needs_yes": false,
      "credit_ceiling": 0,
      "params": {},
      "id": "normalise",
      "local_function": "normalise-inbound",
      "effect": "local",
      "show": "Hold a missing or malformed email."
    },
    {
      "mode": "live",
      "needs_yes": false,
      "credit_ceiling": 0,
      "params": {
        "q": "NORMALISED_EMAIL"
      },
      "id": "search-crm",
      "capability_id": "crm.records.search",
      "effect": "read",
      "show": "Pass the normalised email. An error is class failed."
    },
    {
      "mode": "live",
      "needs_yes": false,
      "credit_ceiling": 0,
      "params": {},
      "id": "classify",
      "local_function": "classify-crm-match",
      "effect": "local",
      "show": "Only new or existing may continue, and only one record."
    },
    {
      "mode": "live",
      "needs_yes": false,
      "credit_ceiling": 0,
      "params": {
        "connection_id": "RESOLVE_AT_RUN_TIME",
        "configuration": {}
      },
      "id": "preview-crm",
      "capability_id": "integrations.crm_management_preview",
      "effect": "read",
      "show": "connection_id comes from the connected CRM, not from this file."
    },
    {
      "mode": "dry_run",
      "needs_yes": true,
      "credit_ceiling": 0,
      "params": {
        "record_id": "ONE_RECORD_ID",
        "provider": "hubspot"
      },
      "id": "sync-one",
      "capability_id": "integrations.sync",
      "effect": "send",
      "show": "One record per yes. provider is hubspot, salesforce, or attio. Queued is not done."
    },
    {
      "mode": "live",
      "needs_yes": false,
      "credit_ceiling": 0,
      "params": {
        "provider": "hubspot"
      },
      "id": "read-health",
      "capability_id": "integrations.health_get",
      "effect": "read",
      "show": "Read queue_depth, failed, dead, and last success after the sync."
    }
  ]
